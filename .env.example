# ==============================================================================
# Database Configuration (PostgreSQL)
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_123
POSTGRES_DB=lms_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Async Database connection string for SQLAlchemy
DATABASE_URL=postgresql+asyncpg://postgres:postgres_secure_password_123@db:5432/lms_db

# ==============================================================================
# Security & JWT Configuration
# ==============================================================================
# Generate a strong key with: openssl rand -hex 32
SECRET_KEY=change_this_to_a_very_secure_random_secret_key_at_least_32_chars_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==============================================================================
# Initial Superadmin User (Bootstrapped on first startup)
# ==============================================================================
FIRST_SUPERADMIN_EMAIL=admin@company.com
FIRST_SUPERADMIN_PASSWORD=admin123
FIRST_SUPERADMIN_NAME=Super Administrator

# ==============================================================================
# Application Settings
# ==============================================================================
PROJECT_NAME="AutoMall LMS"
CORS_ORIGINS=["*"]
ENVIRONMENT=production
FRONTEND_URL=https://lms-amg.duckdns.org

# ==============================================================================
# SMTP Email Notifications (Бесплатная рассылка писем)
# ==============================================================================
# Уведомления о регистрации сотрудников, назначении курсов, аттестаций и оценках.
#
# Вариант 1: Яндекс Почта (Рекомендуется, бесплатно, лимит ~500 писем/день)
# 1. Зайдите в Яндекс ID -> Безопасность -> Пароли приложений -> Создать пароль типа "Почта"
# 2. Вставьте сгенерированный 16-значный пароль в SMTP_PASSWORD
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# SMTP_USER=your_login@yandex.ru
# SMTP_PASSWORD=your_app_password_here
# SMTP_FROM_NAME="Учебный центр AutoMall"
# SMTP_FROM_EMAIL=your_login@yandex.ru
# SMTP_SSL=true
# SMTP_TLS=false
#
# Вариант 2: Mail.ru (Бесплатно)
# 1. Почта Mail.ru -> Настройки -> Безопасность -> Пароли для внешних приложений
# SMTP_HOST=smtp.mail.ru
# SMTP_PORT=465
# SMTP_USER=your_login@mail.ru
# SMTP_PASSWORD=your_app_password_here
# SMTP_FROM_NAME="Учебный центр AutoMall"
# SMTP_FROM_EMAIL=your_login@mail.ru
# SMTP_SSL=true
# SMTP_TLS=false
#
# Вариант 3: Gmail (Google)
# 1. Google Аккаунт -> Безопасность -> 2-этапная аутентификация -> Пароли приложений
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your_login@gmail.com
# SMTP_PASSWORD=your_16_char_app_password
# SMTP_FROM_NAME="Учебный центр AutoMall"
# SMTP_FROM_EMAIL=your_login@gmail.com
# SMTP_SSL=true
# SMTP_TLS=false
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME="Учебный центр AutoMall"
SMTP_FROM_EMAIL=
SMTP_SSL=true
SMTP_TLS=false

